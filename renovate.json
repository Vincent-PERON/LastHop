{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinDependencies", "docker:pinDigests"],
  "pip-compile": {"fileMatch": ["backend/requirements(-dev)?\\.in$"]},
  "vulnerabilityAlerts": {"labels": ["security"], "schedule": ["at any time"]},
  "packageRules": [{"matchUpdateTypes": ["minor", "patch"], "groupName": "non-major", "schedule": ["before 6am on monday"]}]
}
