{
  "realm": "lasthop",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "groups": [{"name": "lasthop-admins"}, {"name": "lasthop-operators"}, {"name": "lasthop-viewers"}],
  "clients": [
    {
      "clientId": "lasthop",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "$(env:KC_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://localhost:8443/api/v1/auth/callback"],
      "webOrigins": [],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "defaultClientScopes": ["openid", "profile", "email"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {"claim.name": "groups", "full.path": "false", "id.token.claim": "true", "access.token.claim": "false", "userinfo.token.claim": "false"}
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dev-admin",
      "enabled": true,
      "email": "dev-admin@example.org",
      "emailVerified": true,
      "groups": ["lasthop-admins"],
      "credentials": [{"type": "password", "value": "$(env:KC_DEV_USER_PASSWORD)", "temporary": false}]
    }
  ]
}
