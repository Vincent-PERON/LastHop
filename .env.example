# Copier en .env (NON commité). Aucune valeur secrète ici : les secrets sont des fichiers dans ./secrets (Docker secrets).
SITE_ADDRESS=lasthop.example.org
HTTPS_PORT=443
HTTP_PORT=80
# prod : refuse un IdP non HTTPS
LASTHOP_ENV=prod
LASTHOP_FRONTEND_ORIGIN=https://lasthop.example.org
# Keycloak : https://keycloak.example.org/realms/lasthop — Entra ID : https://login.microsoftonline.com/<tenant>/v2.0
LASTHOP_OIDC_ISSUER=https://keycloak.example.org/realms/lasthop
LASTHOP_OIDC_CLIENT_ID=lasthop
LASTHOP_OIDC_REDIRECT_URI=https://lasthop.example.org/api/v1/auth/callback
# Groupes IdP -> rôles (Entra : identifiants d'objet des groupes). Format JSON.
LASTHOP_OIDC_ADMIN_GROUPS=["lasthop-admins"]
LASTHOP_OIDC_OPERATOR_GROUPS=["lasthop-operators"]
LASTHOP_OIDC_VIEWER_GROUPS=["lasthop-viewers"]
# Sous-réseau Docker "edge" du proxy, autorisé à fixer X-Forwarded-For (voir docker-compose.yml)
LASTHOP_FORWARDED_ALLOW_IPS=172.30.0.0/24
