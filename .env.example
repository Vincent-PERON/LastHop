# Copier en .env (NON commité). Aucune valeur secrète ici : les secrets sont des fichiers dans ./secrets (Docker secrets).
SITE_ADDRESS=lasthop.example.org
HTTPS_PORT=443
HTTP_PORT=80
# Certificat : laisser par défaut pour Let's Encrypt automatique ; pour fournir votre certificat (proxy/certs/), décommenter :
# TLS_SNIPPET=./proxy/tls-custom.caddy
# prod : refuse une origine non HTTPS
LASTHOP_ENV=prod
LASTHOP_FRONTEND_ORIGIN=https://lasthop.example.org
# Super admin local (mot de passe initial : secrets/local_admin_password, généré par scripts/gen-secrets.sh ; changement imposé
# à la première connexion). Les fournisseurs d'identité (Keycloak, Entra ID, Google Workspace, LDAP) se configurent ensuite
# dans l'interface : page « Authentification ».
LASTHOP_LOCAL_ADMIN_USERNAME=admin
# Sous-réseau Docker "edge" du proxy, autorisé à fixer X-Forwarded-For (voir docker-compose.yml)
LASTHOP_FORWARDED_ALLOW_IPS=172.30.0.0/24
